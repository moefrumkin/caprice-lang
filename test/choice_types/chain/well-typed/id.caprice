(* TEST
    include exhaust;
*)

let id_int (n : int) : int = n

let id_bool (b : bool) : bool = b

let combine f g = fun x -> f x |> g x

let id_combined = combine id_int id_bool

let n : int = id_combined 4

let b : bool = id_combined true

let id_int (n : int) : int = id_combined n

let id_bool (b : bool) : bool = id_combined b