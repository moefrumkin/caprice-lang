let true_type = { b : bool | b }
let false_type = { b : bool | not b }

let is_commutative (rel : int -> int -> int) : bool =
    let x = anyvalue in
    let y = anyvalue in
    ((rel x y) == (rel y x)) |> true

let f (g : int -> int -> int | is_commutative g) (i : int) (j : int) : true_type =
  g i j == g j i